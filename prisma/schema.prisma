generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  emri      String
  telefoni  String?
  email     String?
  adresa    String?
  shenime   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  products  Product[]
  supplies  Supply[]
}

model Product {
  id            Int              @id @default(autoincrement())
  emri          String
  kategoria     String
  /// Current stock on hand.
  /// Guarded in the database by the CHECK constraint
  /// "Product_sasia_non_negative" (sasia >= 0), added in migration
  /// 1_product_stock_non_negative. Prisma does not model CHECK constraints,
  /// so it is invisible here and `prisma migrate diff` will never report it —
  /// do not remove that migration thinking it is unused. A write that would
  /// drive stock below zero fails with SQLSTATE 23514, which the shared API
  /// error handler turns into a 409 "Stoku nuk mjafton".
  sasia         Float            @default(0)
  stokuMinimal  Float            @default(5)
  cmimiBlerjes  Float
  cmimiShitjes  Float
  njesia        String           @default("cope")
  furnitorId    Int?
  furnitor      Supplier?        @relation(fields: [furnitorId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  saleItems     SaleItem[]
  barcodes      ProductBarcode[]
  supplyItems   SupplyItem[]
  personalUses  PersonalUse[]

  @@index([furnitorId])
}

model Supply {
  id         Int          @id @default(autoincrement())
  furnitorId Int?
  furnitor   Supplier?    @relation(fields: [furnitorId], references: [id])
  data       DateTime     @default(now())
  shenime    String?
  totali     Float        @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt
  items      SupplyItem[]

  @@index([furnitorId])
}

model SupplyItem {
  id            Int     @id @default(autoincrement())
  supplyId      Int
  supply        Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product @relation(fields: [productId], references: [id])
  emriProduktit String
  sasia         Float
  njesia        String
  cmimiBlerjes  Float
  totali        Float

  @@index([supplyId])
  @@index([productId])
}

model ProductBarcode {
  id        Int      @id @default(autoincrement())
  barcode   String   @unique
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Sale {
  id          Int        @id @default(autoincrement())
  totali      Float
  fitimi      Float
  shenime     String?
  createdAt   DateTime   @default(now())
  items       SaleItem[]
}

model SaleItem {
  id              Int     @id @default(autoincrement())
  saleId          Int
  productId       Int
  emriProduktit   String
  sasia           Float
  cmimiBlerjes    Float
  cmimiShitjes    Float
  fitimi          Float
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

/// Stock taken out of the shop for the owner's own use.
///
/// Deliberately a separate table from Sale: personal use reduces stock but is
/// not revenue and has no profit, so it must never be reachable from any sales
/// query. Keeping it in its own model makes that structural rather than a
/// filter someone can forget.
model PersonalUse {
  id            Int      @id @default(autoincrement())
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
  /// Snapshotted at the moment of recording, like SaleItem, so later price
  /// changes cannot restate the cost of past entries.
  emriProduktit String
  sasia         Float
  njesia        String
  cmimiBlerjes  Float
  totali        Float
  data          DateTime @default(now())
  /// Supabase auth user id + email of whoever recorded it.
  userId        String
  userEmail     String
  shenime       String?
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([data])
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  email     String
  roli      String   @default("staff")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
