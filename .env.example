# Market OS — environment variables
# Copy to .env and fill in real values. Never commit .env.

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Pooled connection used by the app at runtime (PgBouncer, port 6543).
DATABASE_URL=

# Direct connection used by Prisma for migrations (port 5432). Must bypass the
# pooler — migrations cannot run through PgBouncer in transaction mode.
DIRECT_URL=

# ── Supabase Auth ────────────────────────────────────────────────────────────
# Both are exposed to the browser by design (NEXT_PUBLIC_ prefix). The anon key
# is only safe if row-level security is enabled on your Supabase tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Backups (server only) ────────────────────────────────────────────────────
# Supabase service-role key, used only by the backup code to read and write the
# private "backups" Storage bucket. It bypasses every RLS policy: never give it
# a NEXT_PUBLIC_ prefix and never use it in browser code. Without it, backups
# are off and the Backup & Rikthim page says so.
SUPABASE_SERVICE_ROLE_KEY=
