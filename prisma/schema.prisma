generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Supplier {
  id        Int        @id @default(autoincrement())
  emri      String
  telefoni  String?
  email     String?
  adresa    String?
  shenime   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  products  Product[]
  supplies  Supply[]
}

model Product {
  id            Int              @id @default(autoincrement())
  emri          String
  kategoria     String
  /// Current stock on hand.
  /// Guarded in the database by the CHECK constraint
  /// "Product_sasia_non_negative" (sasia >= 0), added in migration
  /// 1_product_stock_non_negative. Prisma does not model CHECK constraints,
  /// so it is invisible here and `prisma migrate diff` will never report it —
  /// do not remove that migration thinking it is unused. A write that would
  /// drive stock below zero fails with SQLSTATE 23514, which the shared API
  /// error handler turns into a 409 "Stoku nuk mjafton".
  sasia         Float            @default(0)
  stokuMinimal  Float            @default(5)
  cmimiBlerjes  Float
  cmimiShitjes  Float

  /// Pending price change, applied only once the old stock is used up.
  ///
  /// When a supply arrives with new prices while units bought at the old price
  /// are still on the shelf, the new prices wait here instead of silently
  /// re-costing that existing stock. `sasiaVjeter` counts how many units still
  /// belong to the old prices; every sale and personal-use entry reduces it,
  /// and when it reaches zero the pending prices are promoted into
  /// cmimiBlerjes/cmimiShitjes and these three columns are cleared.
  ///
  /// All three are null whenever no change is pending.
  cmimiBlerjesRi Float?
  cmimiShitjesRi Float?
  sasiaVjeter    Float?

  njesia        String           @default("cope")
  /// Shown as a tile on the POS because an admin added it there. kg products
  /// are tiles anyway; this is for everything else (bread, ...). Added in
  /// migration 5_product_pos_tile; snapshots taken before it restore as false.
  neArke        Boolean          @default(false)
  /// POS tile group chosen by an admin (buke, fruta_perime, mish_pule,
  /// djathe_bulmet, embelsira, te_tjera); null = picked automatically from
  /// the name and category. Validated by the API, not the database. Added in
  /// migration 7_product_pos_group; older snapshots restore as null.
  grupiArke     String?
  furnitorId    Int?
  furnitor      Supplier?        @relation(fields: [furnitorId], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  saleItems     SaleItem[]
  barcodes      ProductBarcode[]
  supplyItems   SupplyItem[]
  personalUses  PersonalUse[]

  @@index([furnitorId])
}

model Supply {
  id         Int          @id @default(autoincrement())
  furnitorId Int?
  furnitor   Supplier?    @relation(fields: [furnitorId], references: [id])
  data       DateTime     @default(now())
  shenime    String?
  totali     Float        @default(0)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt
  items      SupplyItem[]

  @@index([furnitorId])
}

model SupplyItem {
  id            Int     @id @default(autoincrement())
  supplyId      Int
  supply        Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product @relation(fields: [productId], references: [id])
  emriProduktit String
  sasia         Float
  njesia        String
  cmimiBlerjes  Float
  /// Sale price set on this delivery, when the operator changed it. Recorded
  /// for history; the live price lives on Product.
  cmimiShitjes  Float?
  totali        Float

  @@index([supplyId])
  @@index([productId])
}

model ProductBarcode {
  id        Int      @id @default(autoincrement())
  barcode   String   @unique
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Sale {
  id          Int        @id @default(autoincrement())
  totali      Float
  fitimi      Float
  shenime     String?
  createdAt   DateTime   @default(now())
  items       SaleItem[]
}

model SaleItem {
  id              Int     @id @default(autoincrement())
  saleId          Int
  productId       Int
  emriProduktit   String
  sasia           Float
  cmimiBlerjes    Float
  cmimiShitjes    Float
  fitimi          Float
  sale            Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

/// One personal-use registration: stock taken out of the shop for the owner's
/// own use, recorded in a single action like a sale.
///
/// Header/line split mirrors Sale/SaleItem and Supply/SupplyItem, so the shape
/// is the one already used everywhere else. Date, user and note belong to the
/// registration as a whole — holding them per line would duplicate them and
/// let the lines of one registration disagree with each other.
///
/// Deliberately separate from Sale: personal use reduces stock but is not
/// revenue and has no profit, so it must never be reachable from a sales
/// query. Keeping it in its own tables makes that structural rather than a
/// filter someone can forget.
model PersonalUseEntry {
  id        Int               @id @default(autoincrement())
  data      DateTime          @default(now())
  /// Supabase auth user id + email of whoever recorded it.
  userId    String
  userEmail String
  shenime   String?
  /// Sum of the line totals, denormalised like Sale.totali.
  totali    Float             @default(0)
  createdAt DateTime          @default(now())
  items     PersonalUse[]

  @@index([data])
}

/// One product line of a personal-use registration.
model PersonalUse {
  id            Int              @id @default(autoincrement())
  entryId       Int
  entry         PersonalUseEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product          @relation(fields: [productId], references: [id])
  /// Snapshotted at the moment of recording, like SaleItem, so later price
  /// changes cannot restate the cost of past entries.
  emriProduktit String
  sasia         Float
  njesia        String
  cmimiBlerjes  Float
  totali        Float
  createdAt     DateTime         @default(now())

  @@index([entryId])
  @@index([productId])
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  email     String
  roli      String   @default("staff")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
