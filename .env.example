# Market OS — environment variables
# Copy to .env and fill in real values. Never commit .env.

# ── Database (Supabase Postgres) ─────────────────────────────────────────────
# Pooled connection used by the app at runtime (PgBouncer, port 6543).
DATABASE_URL=

# Direct connection used by Prisma for migrations (port 5432). Must bypass the
# pooler — migrations cannot run through PgBouncer in transaction mode.
DIRECT_URL=

# ── Supabase Auth ────────────────────────────────────────────────────────────
# Both are exposed to the browser by design (NEXT_PUBLIC_ prefix). The anon key
# is only safe if row-level security is enabled on your Supabase tables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
